[Desktop Entry]
Version=1.0
Type=Application
Name=SURFXR Launcher
GenericName=Game
Comment=SURFXR is an open source remote VR display which allows playing SteamVR games on a standalone headset such as Gear VR or Oculus Go/Quest.
Exec=/usr/bin/flatpak run --command=/app/utils/surfxr/bin/surfxr_launcher com.valvesoftware.Steam
Icon=application-surfxr-launcher
Categories=Game;
StartupNotify=true
StartupWMClass=SURFXR
