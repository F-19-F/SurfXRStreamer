# Debian/Ubuntu multiarch toolchain. Offline execution requires QEMU/binfmt.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SURFXR_EXO_SYSROOT)
if(SURFXR_EXO_SYSROOT)
  set(CMAKE_SYSROOT "${SURFXR_EXO_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
  # Debian cross GCC searches its own runtime before --sysroot by default.
  # Prefer the target SDK's startup objects and system libraries at link time.
  set(CMAKE_C_FLAGS_INIT "-B${CMAKE_SYSROOT}/usr/lib/")
  set(CMAKE_CXX_FLAGS_INIT "-B${CMAKE_SYSROOT}/usr/lib/")
  set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
  set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
  set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
  set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
  set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
  set(CMAKE_CROSSCOMPILING_EMULATOR env "QEMU_LD_PREFIX=${CMAKE_SYSROOT}" qemu-aarch64-static)
  set(OPENSSL_CRYPTO_LIBRARY "${CMAKE_SYSROOT}/usr/lib/libcrypto.so" CACHE FILEPATH "Target crypto")
  set(OPENSSL_INCLUDE_DIR "${CMAKE_SYSROOT}/usr/include" CACHE PATH "Target headers")
  set(Vulkan_LIBRARY "${CMAKE_SYSROOT}/usr/lib/libvulkan.so" CACHE FILEPATH "Target Vulkan loader")
  set(OPENXR_INCLUDE_DIR "${CMAKE_SYSROOT}/usr/include" CACHE PATH "Target XR headers")
  set(FRAME_OPENXR_LOADER "${CMAKE_SYSROOT}/opt/steamvr/bin/linuxarm64/libopenxr_loader.so" CACHE FILEPATH "Target XR loader")
  set(FRAME_OPENVR_LIBRARY "${CMAKE_SYSROOT}/opt/steamvr/bin/linuxarm64/libopenvr_api.so" CACHE FILEPATH "Target VR loader")
  set(FRAME_OPENVR_INCLUDE_DIR "${CMAKE_SYSROOT}/opt/steamvr/tools/hellovr_vulkan_linux/src/openvr/headers" CACHE PATH "Target VR headers")
  set(FRAME_OPENVR_DRIVER_INCLUDE_DIR "${FRAME_OPENVR_INCLUDE_DIR}" CACHE PATH "Target driver headers")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib")
else()
  set(CMAKE_CROSSCOMPILING_EMULATOR qemu-aarch64-static)
  set(ENV{PKG_CONFIG_LIBDIR} "/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig")
  set(OPENSSL_CRYPTO_LIBRARY /usr/lib/aarch64-linux-gnu/libcrypto.so CACHE FILEPATH "Target crypto")
  set(OPENSSL_INCLUDE_DIR /usr/include CACHE PATH "Multiarch headers")
  set(Vulkan_LIBRARY /usr/lib/aarch64-linux-gnu/libvulkan.so CACHE FILEPATH "Target Vulkan loader")
  set(FRAME_OPENXR_LOADER /usr/lib/aarch64-linux-gnu/libopenxr_loader.so CACHE FILEPATH "Target XR loader")
endif()
