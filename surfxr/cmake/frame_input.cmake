# Frame-only system-key bridge. Use the same vendored public OpenVR SDK as PC;
# a device sysroot may contain older sample headers. Never guess ABI versions.
if(UNIX AND NOT APPLE)
  add_library(surfxr-frame-input frame/input/ipc.cpp frame/input/client.cpp frame/input/capture_policy.cpp frame/input/skeleton.cpp)
  target_include_directories(surfxr-frame-input PUBLIC ${SURFXR_PUBLIC_INCLUDE_DIRS})
  target_compile_features(surfxr-frame-input PUBLIC cxx_std_17)
  target_compile_options(surfxr-frame-input PRIVATE -Wall -Wextra -Wpedantic)
  set_target_properties(surfxr-frame-input PROPERTIES POSITION_INDEPENDENT_CODE ON)
  set(FRAME_OPENVR_DRIVER_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/pc/surfxr-server/openvr/headers")
  if(FRAME_OPENVR_DRIVER_INCLUDE_DIR)
    add_library(surfxr-frame-input-driver MODULE frame/input/driver.cpp frame/input/hooks.cpp frame/input/abi.cpp frame/input/devices.cpp frame/input/skeleton_hooks.cpp)
    target_compile_features(surfxr-frame-input-driver PRIVATE cxx_std_17)
    target_include_directories(surfxr-frame-input-driver SYSTEM PRIVATE ${FRAME_OPENVR_DRIVER_INCLUDE_DIR})
    target_link_libraries(surfxr-frame-input-driver PRIVATE surfxr-frame-input Threads::Threads)
    target_compile_options(surfxr-frame-input-driver PRIVATE -Wall -Wextra -Wpedantic -fvisibility=hidden)
    # Hooks can be fetched just before Cleanup. Keep their code resident until
    # vrserver exits; Cleanup restores the interface and releases capture.
    target_link_options(surfxr-frame-input-driver PRIVATE -Wl,-z,nodelete)
    set_target_properties(surfxr-frame-input-driver PROPERTIES PREFIX "" OUTPUT_NAME driver_00_surfxr_exo_input)
  endif()
  add_executable(surfxr-system-input-test tests/frame/input/system_input_test.cpp)
  target_link_libraries(surfxr-system-input-test PRIVATE surfxr-frame-input)
  target_compile_options(surfxr-system-input-test PRIVATE -Wall -Wextra -Wpedantic)
  if(FRAME_OPENVR_DRIVER_INCLUDE_DIR)
    target_sources(surfxr-system-input-test PRIVATE tests/frame/input/hooks_test.cpp frame/input/hooks.cpp frame/input/abi.cpp frame/input/devices.cpp frame/input/skeleton_hooks.cpp)
    target_include_directories(surfxr-system-input-test SYSTEM PRIVATE ${FRAME_OPENVR_DRIVER_INCLUDE_DIR})
    target_include_directories(surfxr-system-input-test PRIVATE frame/input)
    target_compile_definitions(surfxr-system-input-test PRIVATE SURFXR_INPUT_HOOK_TEST=1)
    file(STRINGS "${FRAME_OPENVR_DRIVER_INCLUDE_DIR}/openvr_driver.h" SURFXR_INPUT_POSE_ABI REGEX "virtual.*CreatePoseComponent")
    if(SURFXR_INPUT_POSE_ABI)
      target_compile_definitions(surfxr-system-input-test PRIVATE SURFXR_INPUT_POSE_ABI=1)
    endif()
    file(STRINGS "${FRAME_OPENVR_DRIVER_INCLUDE_DIR}/openvr_driver.h" SURFXR_INPUT_EYE_ABI REGEX "virtual.*CreateEyeTrackingComponent")
    if(SURFXR_INPUT_EYE_ABI)
      target_compile_definitions(surfxr-system-input-test PRIVATE SURFXR_INPUT_EYE_ABI=1)
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
      # The fake interface's dynamic type is visible within this test. Real
      # SteamVR interfaces arrive from GetGenericInterface in another DSO.
      target_compile_options(surfxr-system-input-test PRIVATE -fno-devirtualize -fno-devirtualize-speculatively)
    endif()
  endif()
  add_test(NAME system-input COMMAND surfxr-system-input-test)
  set_tests_properties(system-input PROPERTIES TIMEOUT 20)
endif()
