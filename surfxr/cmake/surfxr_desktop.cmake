option(SURFXR_ENABLE_SURFXR_DESKTOP "Build the optional Windows SURFXR desktop host" OFF)
option(SURFXR_ENABLE_SURFXR_DAEMON "Build the companion SYSTEM desktop/VR daemon" OFF)
if(WIN32 AND SURFXR_ENABLE_SURFXR_DESKTOP)
  set(SURFXR_DESKTOP_FFMPEG_ROOT "" CACHE PATH "Existing FFmpeg development distribution with NVENC")
  find_path(SURFXR_DESKTOP_FFMPEG_INCLUDE libavcodec/avcodec.h HINTS "${SURFXR_DESKTOP_FFMPEG_ROOT}/include" REQUIRED)
  foreach(component avcodec avutil swresample)
    find_library(SURFXR_DESKTOP_${component} NAMES ${component} HINTS "${SURFXR_DESKTOP_FFMPEG_ROOT}/lib" REQUIRED)
  endforeach()
  add_library(surfxr-desktop-core STATIC
    pc/desktop/capture.cpp pc/desktop/encoder.cpp pc/desktop/input.cpp pc/desktop/mouse_activity.cpp pc/desktop/ime_capture.cpp
    pc/desktop/ime_events.cpp pc/desktop/ime_region.cpp pc/desktop/ime_uia.cpp pc/desktop/ime_click.cpp pc/desktop/cursor.cpp
    pc/desktop/network.cpp pc/desktop/host.cpp pc/desktop/dashboard.cpp pc/desktop/audio.cpp pc/desktop/video.cpp pc/desktop/video_sender.cpp pc/desktop/rotation.cpp
    shared/surfxr/stream.cpp shared/surfxr/fec.cpp)
  target_include_directories(surfxr-desktop-core PUBLIC pc/desktop)
  target_compile_features(surfxr-desktop-core PUBLIC cxx_std_17)
  target_include_directories(surfxr-desktop-core SYSTEM PUBLIC "${SURFXR_DESKTOP_FFMPEG_INCLUDE}")
  target_compile_definitions(surfxr-desktop-core PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_options(surfxr-desktop-core PUBLIC /W4 /utf-8)
  target_compile_options(surfxr-desktop-core PUBLIC "/external:I${SURFXR_DESKTOP_FFMPEG_INCLUDE}" /external:W0)
  target_link_libraries(surfxr-desktop-core PUBLIC ${SURFXR_DESKTOP_avcodec} ${SURFXR_DESKTOP_avutil} ${SURFXR_DESKTOP_swresample}
    ws2_32 bcrypt d3d11 dxgi d3dcompiler user32 gdi32 advapi32 wtsapi32 userenv ole32 oleaut32 shell32 winmm)
  add_executable(surfxr-desktop pc/desktop/main.cpp pc/desktop/service.cpp pc/desktop/install.cpp tests/pc/media_lease_checks.cpp tests/pc/ime_capture_checks.cpp tests/pc/desktop_color_checks.cpp tests/pc/dashboard_watch_checks.cpp)
  target_link_libraries(surfxr-desktop PRIVATE surfxr-desktop-core)
  add_library(surfxr-desktop-module SHARED pc/desktop/module.cpp)
  target_link_libraries(surfxr-desktop-module PRIVATE surfxr-desktop-core)
  set(SURFXR_SURFXR_ROOT "${PROJECT_SOURCE_DIR}/pc/surfxr-server" CACHE PATH "Matching companion SURFXR sources for private GPU IPC")
  if(SURFXR_ENABLE_SURFXR_DAEMON)
    if(NOT EXISTS "${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp/platform/win32/frame-worker/FrameDaemonIPC.h")
      message(FATAL_ERROR "SURFXR_ENABLE_SURFXR_DAEMON requires the matching companion SURFXR source tree")
    endif()
    add_executable(surfxr-daemon pc/daemon/main.cpp pc/daemon/runtime.cpp pc/daemon/session.cpp pc/daemon/keyboard.cpp
      pc/daemon/backend.cpp pc/daemon/vr.cpp pc/daemon/audio.cpp pc/daemon/worker.cpp
      pc/desktop/service.cpp pc/desktop/install.cpp)
    target_include_directories(surfxr-daemon SYSTEM PRIVATE "${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp")
    target_compile_options(surfxr-daemon PRIVATE "/external:I${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp" /external:W0)
    target_link_libraries(surfxr-daemon PRIVATE surfxr-desktop-core)
    add_executable(surfxr-daemon-worker-test tests/pc/daemon_worker_checks.cpp tests/pc/daemon_backend_checks.cpp
      pc/daemon/worker.cpp pc/daemon/backend.cpp pc/daemon/vr.cpp)
    target_include_directories(surfxr-daemon-worker-test SYSTEM PRIVATE "${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp")
    target_compile_options(surfxr-daemon-worker-test PRIVATE "/external:I${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp" /external:W0)
    target_link_libraries(surfxr-daemon-worker-test PRIVATE surfxr-desktop-core)
    add_test(NAME daemon-worker-ipc COMMAND surfxr-daemon-worker-test)
    set_tests_properties(daemon-worker-ipc PROPERTIES TIMEOUT 15)
  endif()
  file(GLOB SURFXR_DESKTOP_RUNTIME_DLLS "${SURFXR_DESKTOP_FFMPEG_ROOT}/bin/*.dll")
  foreach(runtime_dll IN LISTS SURFXR_DESKTOP_RUNTIME_DLLS)
    add_custom_command(TARGET surfxr-desktop POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${runtime_dll}" "$<TARGET_FILE_DIR:surfxr-desktop>")
  endforeach()
  if(EXISTS "${SURFXR_DESKTOP_FFMPEG_ROOT}/LICENSE.txt")
    add_custom_command(TARGET surfxr-desktop POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${SURFXR_DESKTOP_FFMPEG_ROOT}/LICENSE.txt" "$<TARGET_FILE_DIR:surfxr-desktop>/FFmpeg.LICENSE.txt")
  endif()
  add_test(NAME surfxr-desktop-offline COMMAND surfxr-desktop --self-test)
  add_executable(surfxr-desktop-video-test tests/pc/desktop_video_checks.cpp pc/desktop/video_sender.cpp
    shared/surfxr/stream.cpp shared/surfxr/fec.cpp)
  target_compile_features(surfxr-desktop-video-test PRIVATE cxx_std_17)
  target_include_directories(surfxr-desktop-video-test SYSTEM PRIVATE "${SURFXR_DESKTOP_FFMPEG_INCLUDE}")
  target_compile_definitions(surfxr-desktop-video-test PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_options(surfxr-desktop-video-test PRIVATE /W4 /utf-8 "/external:I${SURFXR_DESKTOP_FFMPEG_INCLUDE}" /external:W0)
  target_link_libraries(surfxr-desktop-video-test PRIVATE ws2_32 bcrypt advapi32 winmm)
  add_test(NAME desktop-video-lifecycle COMMAND surfxr-desktop-video-test)
  set_tests_properties(desktop-video-lifecycle PROPERTIES TIMEOUT 10)
  find_library(SURFXR_DESKTOP_swscale NAMES swscale HINTS "${SURFXR_DESKTOP_FFMPEG_ROOT}/lib" REQUIRED)
  target_link_libraries(surfxr-desktop PRIVATE ${SURFXR_DESKTOP_swscale})
  add_executable(surfxr-software-color-test tests/pc/software_color_checks.cpp)
  target_compile_features(surfxr-software-color-test PRIVATE cxx_std_17)
  target_include_directories(surfxr-software-color-test PRIVATE
    "${SURFXR_SURFXR_ROOT}/surfxr/server_openvr/cpp/platform/win32")
  target_include_directories(surfxr-software-color-test SYSTEM PRIVATE "${SURFXR_DESKTOP_FFMPEG_INCLUDE}")
  target_compile_options(surfxr-software-color-test PRIVATE /W4 /utf-8)
  target_link_libraries(surfxr-software-color-test PRIVATE ${SURFXR_DESKTOP_swscale} ${SURFXR_DESKTOP_avutil})
  foreach(runtime_dll IN LISTS SURFXR_DESKTOP_RUNTIME_DLLS)
    add_custom_command(TARGET surfxr-software-color-test POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${runtime_dll}" "$<TARGET_FILE_DIR:surfxr-software-color-test>")
  endforeach()
  add_test(NAME software-encoder-color COMMAND surfxr-software-color-test)
  set_tests_properties(software-encoder-color PROPERTIES TIMEOUT 10)
  include(cmake/pc_encoder_tests.cmake)
  include(cmake/pc_input_tests.cmake)
endif()
